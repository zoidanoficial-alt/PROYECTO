   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Noche de neón de los 80: cálido y luminoso, sombras magenta, luces turquesa, negros lavados por la curva, aguas giradas al azul y grano. Incluye la Exposición del reel (+0.65).</rdf:li>
    </rdf:Alt>
