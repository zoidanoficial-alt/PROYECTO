    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar SL3</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Versión para Canon Rebel SL3 / 250D. Inspirado en Dune (Greig Fraser, Óscar a Mejor Fotografía 2022). Desierto de arena ocre: contraste suave, color contenido, sombras ligeramente frías y luces cremosas. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
