   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SL3 2019 Cuarón · Plata nítida</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar SL3</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Versión para Canon Rebel SL3 / 250D. Inspirado en Roma (Alfonso Cuarón, Óscar a Mejor Fotografía 2019). Blanco y negro digital y limpio, con mucho detalle en luces y sombras: gris plateado y sin grano. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
