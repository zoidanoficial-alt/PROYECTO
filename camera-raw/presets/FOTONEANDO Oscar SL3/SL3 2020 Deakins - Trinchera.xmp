   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SL3 2020 Deakins · Trinchera</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar SL3</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Versión para Canon Rebel SL3 / 250D. Inspirado en 1917 (Roger Deakins, Óscar a Mejor Fotografía 2020). Naturalismo de guerra: verdes y amarillos apagados, piel natural, cielos grises y contraste moderado. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
