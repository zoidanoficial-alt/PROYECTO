   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SL3 2016 Lubezki · Luz natural de invierno</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar SL3</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Versión para Canon Rebel SL3 / 250D. Inspirado en The Revenant (Emmanuel Lubezki, Óscar a Mejor Fotografía 2016). Solo luz natural: invierno frío y desaturado, nieve gris azulada, verdes apagados y luces suaves. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
