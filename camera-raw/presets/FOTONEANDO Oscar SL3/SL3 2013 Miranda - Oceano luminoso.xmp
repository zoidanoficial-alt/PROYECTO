   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">SL3 2013 Miranda · Océano luminoso</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar SL3</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Versión para Canon Rebel SL3 / 250D. Inspirado en Life of Pi (Claudio Miranda, Óscar a Mejor Fotografía 2013). Color limpio y luminoso, con aguas y cielos turquesa intensos, como una pintura brillante. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
