   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Inspirado en Blade Runner 2049 (Roger Deakins, Óscar a Mejor Fotografía 2018). Ciudad cubierta de bruma naranja: casi monocromo, contraste bajo y luces que se disuelven. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
