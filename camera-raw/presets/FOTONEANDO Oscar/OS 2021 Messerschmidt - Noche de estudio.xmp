   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">OS 2021 Messerschmidt · Noche de estudio</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
