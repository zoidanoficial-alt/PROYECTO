   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Inspirado en Mank (Erik Messerschmidt, Óscar a Mejor Fotografía 2021). Blanco y negro de estudio de los años 30 y 40: negros densos, brillo en las luces, grano y viñeta. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
