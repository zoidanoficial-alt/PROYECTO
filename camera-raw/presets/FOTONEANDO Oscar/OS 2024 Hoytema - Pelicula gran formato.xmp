   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FOTONEANDO · Óscar</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Inspirado en Oppenheimer (Hoyte van Hoytema, Óscar a Mejor Fotografía 2024). Película de gran formato: piel cálida y rica, negros profundos, color natural y grano finísimo. Interpretación libre, no es el etalonaje oficial.</rdf:li>
    </rdf:Alt>
   </crs:Description>
